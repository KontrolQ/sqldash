{% extends "layouts/base.django" %}
{% block content %}
  <div class="page-head">
    <div class="page-title">
      <h1>SMTP settings</h1>
      <p class="page-subtitle">Configure outgoing email for this instance.</p>
    </div>
  </div>
  {% include "partials/alert.django" %}
  <div class="admin-settings-page">
    <div class="admin-settings-heading">
      <div>
        <h2>SMTP</h2>
        <p>Send invitation and recovery links from your mail server.</p>
      </div>
      <span class="admin-status {% if Configured %}is-active{% endif %}"><span></span>
      {% if Configured %}
        Configured
      {% else %}
        Not configured
      {% endif %}
      </span>
    </div>
    {% if not Configured %}
      <p class="admin-notice">Email delivery is not configured.</p>
    {% endif %}
    <form method="post" action="{% url "admin.smtp.save" %}">
      <section class="admin-settings-section">
        <div class="admin-section-label">
          <h3>Connection</h3>
          <p>Your outgoing mail server.</p>
        </div>
        <div class="admin-settings-fields">
          <div class="field"><label class="label" for="smtp-host">SMTP host</label><input class="input" name="host" id="smtp-host" value="{{ SMTP.Host }}" placeholder="smtp.example.com" required></div>
          <div class="field"><label class="label" for="smtp-port">Port</label><input class="input" type="number" name="port" id="smtp-port" min="1" max="65535" value="{{ SMTP.Port }}" required></div>
          <div class="field"><label class="label">Security</label>{% include "partials/select.django" with select_name="security" select_label="SMTP security" select_chosen=SMTP.Security select_options=SecurityOptions select_wide=1 %}</div>
        </div>
      </section>
      <section class="admin-settings-section">
        <div class="admin-section-label">
          <h3>Authentication</h3>
          <p>Credentials for the mail server.</p>
        </div>
        <div class="admin-settings-fields">
          <div class="field"><label class="label" for="smtp-username">Username</label><input class="input" name="username" id="smtp-username" value="{{ SMTP.Username }}" autocomplete="off"></div>
          <div class="field">
            <label class="label" for="smtp-password">Password</label>
            <div class="password" data-password><input class="input" type="password" name="password" id="smtp-password" value="{{ SMTPPassword }}" autocomplete="off"><button class="password-toggle" type="button" data-password-toggle aria-label="Show password" aria-pressed="false"><svg class="icon-show" viewBox="0 0 24 24"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><svg class="icon-hide" viewBox="0 0 24 24"><path d="m2 2 20 20M9 5a13 13 0 0 1 3 0c7 0 10 7 10 7a19 19 0 0 1-3 4M6 6a20 20 0 0 0-4 6s3 7 10 7a13 13 0 0 0 6-2"/></svg></button></div>
            <span class="field-note">Leave blank to keep the saved password.</span>
          </div>
        </div>
      </section>
      <section class="admin-settings-section">
        <div class="admin-section-label">
          <h3>Sender</h3>
          <p>What recipients see in their inbox.</p>
        </div>
        <div class="admin-settings-fields">
          <div class="field"><label class="label" for="smtp-from">From email</label><input class="input" type="email" name="from_email" id="smtp-from" value="{{ SMTP.FromEmail }}" placeholder="sqldash@example.com" required></div>
          <div class="field"><label class="label" for="smtp-name">From name</label><input class="input" name="from_name" id="smtp-name" value="{{ SMTP.FromName }}" placeholder="sqldash"></div>
        </div>
      </section>
      <div class="admin-settings-save"><button class="button" type="submit">Save SMTP settings</button></div>
    </form>
    {% if Configured %}
      <section class="admin-settings-section">
        <div class="admin-section-label">
          <h3>Test delivery</h3>
          <p>Send a test using the saved settings.</p>
        </div>
        <form class="admin-settings-fields" method="post" action="{% url "admin.smtp.test" %}">
          <div class="field"><label class="label" for="smtp-test-recipient">Recipient</label><input class="input" id="smtp-test-recipient" type="email" name="recipient" required></div>
          <div class="admin-actions"><button class="button is-outline" type="submit">Send test email</button></div>
        </form>
      </section>
      <section class="admin-settings-section">
        <div class="admin-section-label">
          <h3>Disable email</h3>
          <p>Remove the SMTP configuration. Links remain available to copy.</p>
        </div>
        <form class="admin-settings-fields" method="post" action="{% url "admin.smtp.clear" %}" data-confirm="This removes the saved mail-server credentials and stops sending emails." data-confirm-title="Clear SMTP settings?" data-confirm-action="Clear configuration">
          <div class="admin-actions"><button class="button is-outline admin-danger" type="submit">Clear configuration</button></div>
        </form>
      </section>
    {% endif %}
  </div>
{% endblock %}
