{% extends "layouts/gate.django" %}

{% block content %}
<div class="gate-card">
<h1 class="gate-title">Sign in</h1>
<p class="gate-note">Enter your username and password.</p>

{% if Problem %}<div class="notice is-bad">{{ Problem }}</div>{% endif %}

<form class="gate-form" method="post" action="{% url "auth.signin" %}">
<div class="field">
<label class="label" for="username">Username</label>
<input class="input" id="username" name="username" autocomplete="username" autofocus required>
</div>
<div class="field">
<label class="label" for="password">Password</label>
{% include "partials/password.django" with field_id="password" field_name="password" field_autocomplete="current-password" %}
</div>
<button class="button is-block" type="submit">Sign in</button>
</form>
</div>
{% endblock %}
