{% extends "layouts/base.django" %}

{% block content %}
<div class="page-head">
<h1>Databases</h1>
<span class="page-head-note">{{ Databases|length }} on this server</span>
</div>

{% if Databases %}
<div class="panel">
<table class="table">
<thead>
<tr>
<th>Name</th>
<th>State</th>
</tr>
</thead>
<tbody>
{% for database in Databases %}
<tr>
<td>{{ database.Name }}</td>
<td>{% if database.Protected %}<span class="tag is-protected">protected</span>{% else %}<span class="tag">open</span>{% endif %}</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
{% else %}
<div class="empty">No databases yet.</div>
{% endif %}
{% endblock %}
