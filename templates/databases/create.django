<div class="sheet-veil" data-sheet="new-database-{{ create_engine }}"{% if create_engine != "postgres" or not RemoteCloneForm or not CanCloneRemote %} hidden{% endif %}>
  <div class="dialog-veil" data-sheet-close></div>
  <div class="dialog is-wide clone-dialog" role="dialog" aria-modal="true" aria-labelledby="create-database-title-{{ create_engine }}">
    <div class="dialog-head"><div class="dialog-title" id="create-database-title-{{ create_engine }}">Create a {{ create_label }} database</div><div class="dialog-note">{% if create_engine == "postgres" %}Connect with a PostgreSQL username and password.{% else %}Create an empty database or import a SQLite file or SQL dump.{% endif %}</div></div>
    <div class="tabs" data-swap>
      <button class="tab{% if create_engine != "postgres" or not RemoteCloneForm or not CanCloneRemote %} is-current{% endif %}" type="button" data-swap-to="make-{{ create_engine }}-empty">Empty</button>
      {% if can_import %}<button class="tab" type="button" data-swap-to="make-{{ create_engine }}-dump">From a file</button>{% endif %}
      {% if create_engine == "postgres" and CanCloneRemote %}<button class="tab{% if RemoteCloneForm %} is-current{% endif %}" type="button" data-swap-to="make-postgres-remote">Remote PostgreSQL</button>{% endif %}
    </div>
    <form class="stack" method="post" action="{% url "databases.create" %}" data-swap-panel="make-{{ create_engine }}-empty"{% if create_engine == "postgres" and RemoteCloneForm and CanCloneRemote %} hidden{% endif %}>
      <input type="hidden" name="engine" value="{{ create_engine }}">
      <div class="field"><label class="label" for="create-{{ create_engine }}-name">Name</label><input class="input" id="create-{{ create_engine }}-name" name="name" minlength="2" maxlength="48" required><span class="field-note">Lowercase letters, digits and hyphens.</span></div>
      <div class="dialog-foot"><button class="button is-outline" type="button" data-sheet-open="new-database">Back</button><button class="button" type="submit">Create database</button></div>
    </form>
    {% if can_import %}
      <form class="stack" method="post" action="{% url "databases.import" %}" enctype="multipart/form-data" data-swap-panel="make-{{ create_engine }}-dump" hidden>
        <input type="hidden" name="engine" value="{{ create_engine }}">
        <div class="field"><label class="label" for="import-{{ create_engine }}-name">Name</label><input class="input" id="import-{{ create_engine }}-name" name="name" minlength="2" maxlength="48" required></div>
        <div class="field"><label class="label" for="import-{{ create_engine }}-dump">File</label><input class="file" id="import-{{ create_engine }}-dump" type="file" name="dump" accept="{% if create_engine == "postgres" %}.sql,.dump,.backup{% else %}.sql,.db,.sqlite,.sqlite3{% endif %}" required><span class="field-note">{% if create_engine == "postgres" %}A PostgreSQL archive (recommended) or native PostgreSQL SQL dump.{% else %}A SQLite database file or SQLite SQL dump.{% endif %}</span></div>
        <div class="dialog-foot"><button class="button is-outline" type="button" data-sheet-open="new-database">Back</button><button class="button" type="submit">Load database</button></div>
      </form>
    {% endif %}
    {% if create_engine == "postgres" and CanCloneRemote %}
      {% include "databases/remote.django" with remote_panel="make-postgres-remote" remote_hidden=1 remote_back=1 %}
    {% endif %}
  </div>
</div>
