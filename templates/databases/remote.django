<form class="stack" method="post" action="{% url "databases.import.remote" %}" enctype="multipart/form-data" autocomplete="off" data-swap-panel="{{ remote_panel }}" data-remote-clone data-remote-clone-success="{% url "databases" %}"{% if remote_hidden and not RemoteCloneForm %} hidden{% endif %}>
  <div class="alert is-bad" role="alert" tabindex="-1" data-remote-clone-error{% if not RemoteCloneForm %} hidden{% endif %}><div class="alert-title" data-remote-clone-heading>Clone failed</div><div class="alert-body" data-remote-clone-message>{{ RemoteCloneForm.Error|capfirst }}</div></div>
  {% if RemoteCloneForm %}
    <div class="field-note">Your password was not retained. Enter it again and reselect your CA certificate, if you used one.</div>
  {% endif %}
  <div class="field"><span class="label">Target engine</span><span class="badge is-outline">PostgreSQL</span><span class="field-note">Copy one remote PostgreSQL database into a new PostgreSQL database. The source is read only.</span></div>
  <div class="field"><label class="label" for="remote-target-name">Name for the new database</label><input class="input" id="remote-target-name" name="name" value="{{ RemoteCloneForm.Name }}" minlength="2" maxlength="48" required><span class="field-note">A new, globally unique name. Existing databases are never overwritten.</span></div>
  <div class="row"><div class="field"><label class="label" for="remote-source-host">Source hostname</label><input class="input" id="remote-source-host" name="source_host" value="{{ RemoteCloneForm.Host }}" placeholder="db.example.com" required></div><div class="field"><label class="label" for="remote-source-port">Port</label><input class="input" id="remote-source-port" name="source_port" type="number" min="1" max="65535" value="{% if RemoteCloneForm %}{{ RemoteCloneForm.Port }}{% else %}5432{% endif %}" required></div></div>
  <div class="field"><label class="label" for="remote-source-database">Source database</label><input class="input" id="remote-source-database" name="source_database" value="{{ RemoteCloneForm.Database }}" required></div>
  <div class="row"><div class="field"><label class="label" for="remote-source-username">Username</label><input class="input" id="remote-source-username" name="source_username" value="{{ RemoteCloneForm.Username }}" autocomplete="off" required></div><div class="field"><label class="label" for="remote-source-password">Password</label>{% include "partials/password.django" with field_id="remote-source-password" field_name="source_password" field_autocomplete="off" %}</div></div>
  <div class="field"><span class="label">Source TLS</span>{% include "partials/select.django" with select_name="source_sslmode" select_label="Source TLS verification" select_chosen=RemoteCloneForm.SSLMode|default:"verify-full" select_options=RemoteTLSModes select_wide=1 %}<span class="field-note">Verified TLS is selected by default. Choose No SSL only if you intend to send credentials and data without transport encryption.</span></div>
  <div class="field"><label class="label" for="remote-source-ca">Source CA certificate (optional)</label><input class="file" id="remote-source-ca" name="source_ca" type="file" accept=".pem,.crt,.cer"><span class="field-note">A public PEM CA certificate, not a private key. Verified modes otherwise use the instance trust store. Encryption-only and No SSL modes do not accept a CA file.</span></div>
  {% include "databases/clonebusy.django" %}
  <div class="dialog-foot">{% if remote_back %}<button class="button is-outline" type="button" data-sheet-open="new-database">Back</button>{% else %}<button class="button is-outline" type="button" data-sheet-close>Cancel</button>{% endif %}<button class="button" type="submit">Clone database</button></div>
</form>
