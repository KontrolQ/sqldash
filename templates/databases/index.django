{% extends "layouts/base.django" %}
{% block content %}
  <div class="page-head">
    <div class="page-title">
      <h1>Databases</h1>
      <p class="page-subtitle">The databases you have access to.</p>
    </div>
    {% if CanCreateDatabases %}
      <div class="page-actions">
        <button class="button" type="button" data-sheet-open="new-database">
<svg class="button-icon" viewBox="0 0 24 24"><path d="M5 12h14M12 5v14"/></svg>
Create database
</button>
      </div>
    {% endif %}
  </div>
  {% include "partials/alert.django" %}
  {% if RemoteCloneForm and not CanCloneRemote %}
    <div class="alert is-bad" role="alert"><div class="alert-title">Clone failed</div><div class="alert-body">{{ RemoteCloneForm.Error|capfirst }}</div></div>
  {% endif %}
  <nav class="tabs database-engine-tabs" aria-label="Database engine">
    <a class="tab{% if not Engine %} is-current{% endif %}" href="{% url "databases" %}"{% if not Engine %} aria-current="page"{% endif %}>All</a>
    <a class="tab{% if Engine == "libsql" %} is-current{% endif %}" href="{% url "databases" %}?engine=libsql"{% if Engine == "libsql" %} aria-current="page"{% endif %}>libSQL</a>
    <a class="tab{% if Engine == "postgres" %} is-current{% endif %}" href="{% url "databases" %}?engine=postgres"{% if Engine == "postgres" %} aria-current="page"{% endif %}>PostgreSQL</a>
  </nav>
  {% if Databases %}
    <div class="card is-table">
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Engine</th>
              <th scope="col">Address</th>
              <th scope="col" class="table-numeric">Tables</th>
              <th scope="col" class="table-numeric">Storage</th>
              <th scope="col" class="table-numeric">Rows read</th>
              <th scope="col" class="table-numeric">Queries</th>
              <th scope="col">State</th>
              <th scope="col" class="table-pick"></th>
            </tr>
          </thead>
          <tbody>
            {% for database in Databases %}
              <tr>
                <td><a class="table-name" href="{% url "databases.show" name=database.Name %}"><span class="dot {% if database.Blocked or not database.Online %}is-blocked{% else %}is-live{% endif %}"></span>{{ database.Name }}</a></td>
                <td><span class="badge is-outline">{{ database.EngineLabel }}</span></td>
                <td class="mono muted">{{ database.Address }}</td>
                <td class="table-numeric">{{ database.Tables }}</td>
                <td class="table-numeric">{{ database.Storage }}</td>
                <td class="table-numeric">{{ database.RowsRead }}</td>
                <td class="table-numeric">{{ database.Queries }}</td>
                <td>
                  {% if not database.Ready %}<span class="badge is-outline">{{ database.State }}</span>{% elif not database.Online %}<span class="badge is-outline">Offline</span>{% elif database.Blocked %}
                    <span class="badge is-outline">Blocked</span>
                  {% elif database.Protected %}
                    <span class="badge is-secondary">Protected</span>
                  {% else %}
                    <span class="badge is-outline">Open</span>
                  {% endif %}
                </td>
                <td class="table-pick">
                  <div class="menu" data-menu>
                    <button class="step" type="button" data-menu-trigger aria-expanded="false" aria-haspopup="true" aria-label="More actions for {{ database.Name }}">
<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
</button>
                    <div class="menu-content" data-menu-content hidden>
                      <a class="menu-plain" href="{% url "databases.show" name=database.Name %}">Manage</a>
                      {% if database.Actions.CanReadData and database.Ready %}
                        <a class="menu-plain" href="{% url "databases.explore" name=database.Name %}">Browse data</a>
                      {% endif %}
                      {% if database.Actions.CanRunSQL and database.Ready %}
                        <a class="menu-plain" href="{% url "databases.console" name=database.Name %}">Open the console</a>
                      {% endif %}
                      {% if database.Ready and database.Actions.CanForkDatabases and database.Actions.CanCreateDatabases and database.Actions.CanReadData %}<button class="menu-plain" type="button" data-sheet-open="duplicate-database-{{ database.Name }}">Duplicate</button>{% endif %}
                      {% if database.Actions.CanExportDatabases and database.Ready %}
                        <div class="menu-separator"></div>
                        <a class="menu-plain" href="{% url "databases.export" name=database.Name %}">Download a dump</a>
                      {% endif %}
                    </div>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% else %}
    <div class="empty">
      <span class="empty-title">No databases yet</span>
<span>
      {% if CanCreateDatabases %}
        Create one to get started.
      {% else %}
        Ask an administrator or database owner to share one with you.
      {% endif %}
      </span>
    </div>
  {% endif %}
  {% for database in Databases %}
    {% if database.Ready and database.Actions.CanForkDatabases and database.Actions.CanCreateDatabases and database.Actions.CanReadData %}
      {% include "databases/duplicate.django" %}
    {% endif %}
  {% endfor %}
  {% if CanCreateDatabases %}
    {% include "databases/chooser.django" %}
  {% endif %}
{% endblock %}
{% block styles %}
  <link rel="stylesheet" href="{% static "css/databases.css" %}">
{% endblock %}
{% block scripts %}
  <script src="{% static "js/databases.js" %}" defer></script>
{% endblock %}
