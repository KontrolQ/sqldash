{% extends "layouts/base.django" %}

{% block content %}
<div class="page-head">
<div class="page-title">
<h1>Databases</h1>
<p class="page-subtitle">Every database this server holds.</p>
</div>
</div>

{% include "partials/alert.django" %}

<div class="row">
<div class="card">
<div class="card-head has-border">
<div class="card-title">New database</div>
<div class="card-note">Starts empty.</div>
</div>
<div class="card-body">
<form class="stack" method="post" action="{% url "databases.create" %}">
<div class="field">
<label class="label" for="create-name">Name</label>
<input class="input" id="create-name" name="name" required>
<span class="field-note">Lowercase letters, digits and hyphens.</span>
</div>
<div class="actions">
<button class="button" type="submit">Create database</button>
</div>
</form>
</div>
</div>

<div class="card">
<div class="card-head has-border">
<div class="card-title">Load a dump</div>
<div class="card-note">Builds a database from a .sql file.</div>
</div>
<div class="card-body">
<form class="stack" method="post" action="{% url "databases.import" %}" enctype="multipart/form-data">
<div class="field">
<label class="label" for="import-name">Name</label>
<input class="input" id="import-name" name="name" required>
</div>
<div class="field">
<label class="label" for="import-dump">Dump</label>
<input class="file" id="import-dump" type="file" name="dump" accept=".sql" required>
</div>
<div class="actions">
<button class="button is-outline" type="submit">Load database</button>
</div>
</form>
</div>
</div>
</div>

{% if Databases %}
<div class="card is-table">
<div class="table-wrap">
<table class="table">
<thead>
<tr><th>Name</th><th>Address</th><th>State</th><th></th></tr>
</thead>
<tbody>
{% for database in Databases %}
<tr>
<td><a class="table-name" href="{% url "databases.show" name=database.Name %}"><span class="dot is-live"></span>{{ database.Name }}</a></td>
<td class="mono muted">{{ database.Address }}</td>
<td>{% if database.Protected %}<span class="badge is-secondary">Protected</span>{% else %}<span class="badge is-outline">Open</span>{% endif %}</td>
<td class="table-actions"><a class="button is-ghost is-small" href="{% url "databases.show" name=database.Name %}">Manage</a></td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
</div>
{% else %}
<div class="empty">
<span class="empty-title">No databases yet</span>
<span>Create one above to get started.</span>
</div>
{% endif %}
{% endblock %}
