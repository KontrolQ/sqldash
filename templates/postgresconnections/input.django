<div class="postgres-input{% if credential_secret %} password{% endif %}"{% if credential_secret %} data-password{% endif %}>
  <input class="input mono" id="{{ credential_id }}" type="{% if credential_secret %}password{% else %}text{% endif %}" value="{{ credential_value }}" autocomplete="off" readonly>
  <div class="postgres-input-actions">
    {% if credential_secret %}
      <button class="password-toggle" type="button" data-password-toggle aria-label="Show {{ credential_label|lower }}" aria-pressed="false" aria-controls="{{ credential_id }}"><svg class="icon-show" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7S2 12 2 12"/><circle cx="12" cy="12" r="3"/></svg><svg class="icon-hide" viewBox="0 0 24 24" aria-hidden="true"><path d="m2 2 20 20M6 6C3 8 2 12 2 12s3 7 10 7c2 0 4-1 6-2M10 5h2c7 0 10 7 10 7l-2 3"/></svg></button>
    {% endif %}
    <button class="postgres-input-copy" type="button" {% if credential_secret %}data-postgres-copy-input="{{ credential_id }}" data-postgres-copy-label="The {{ credential_label|lower }}"{% else %}data-copy="{{ credential_id }}" data-copy-label="The {{ credential_label|lower }}"{% endif %} aria-label="Copy {{ credential_label|lower }}" title="Copy {{ credential_label|lower }}"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H3a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1h11a1 1 0 0 1 1 1v2"/></svg></button>
  </div>
</div>
