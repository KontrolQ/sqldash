<div class="drawer" id="redis-create" hidden>
  <div class="drawer-head"><span class="card-title" data-redis-create-title>Add a key</span><button class="step" type="button" data-reveal="redis-create" aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button></div>
  <form class="drawer-body" method="post" action="{{ APIPath }}/keys/mutate" data-redis-create-form>
    <div class="row" data-redis-create-identity><div class="field"><label class="label" for="redis-create-name">Key name</label><input class="input" id="redis-create-name" name="key" required><span class="field-note">Names and values may contain arbitrary bytes.</span></div><div class="field"><span class="label">Key encoding</span>{% include "partials/select.django" with select_name="keyEncoding" select_label="Key encoding" select_chosen="text" select_options=ByteEncodings select_wide=1 %}</div><div class="field"><span class="label">Type</span>{% include "partials/select.django" with select_name="type" select_label="Key type" select_chosen="string" select_options=KeyTypes select_wide=1 select_hook="redis-create-type" %}</div></div>
    <div class="row"><div class="field"><span class="label">Value encoding</span>{% include "partials/select.django" with select_name="encoding" select_label="Value encoding" select_chosen="text" select_options=ByteEncodings select_wide=1 %}</div><div class="field" data-redis-create-field hidden><label class="label" for="redis-create-field">Field</label><input class="input" id="redis-create-field" name="field"><span class="field-note">Uses the selected value encoding.</span></div><div class="field" data-redis-create-score hidden><label class="label" for="redis-create-score">Score</label><input class="input" id="redis-create-score" name="score" value="0" inputmode="decimal"></div><div class="field" data-redis-create-stream hidden><label class="label" for="redis-create-stream">Stream ID</label><input class="input" id="redis-create-stream" name="streamID" value="*"><span class="field-note">Use * for a server-generated ID.</span></div></div>
    <div class="field">
      <label class="label" for="redis-create-value" data-redis-create-value-label>Value</label>
      <textarea class="input mono" id="redis-create-value" name="value" rows="3"></textarea>
      <span class="field-note" data-redis-create-value-note>Empty values are allowed. Creating a key never overwrites an existing key.</span>
    </div>
    <div class="field" data-redis-create-stream-fields hidden>
      <label class="label" for="redis-create-extra-fields">Additional fields</label>
      <textarea class="input mono" id="redis-create-extra-fields" name="extraFields" rows="2" placeholder='[{"field":"name","value":"text"}]'>[]</textarea>
      <span class="field-note">Optional JSON array of string field/value pairs in the selected encoding.</span>
    </div>
    <div class="row" data-redis-create-expiry-row><div class="field"><span class="label">Expiry</span>{% include "partials/select.django" with select_name="expiryMode" select_label="Expiry" select_chosen="persistent" select_options=ExpiryModes select_wide=1 select_hook="redis-create-expiry" %}</div><div class="field" data-redis-create-relative hidden><label class="label" for="redis-create-duration">Duration</label><input class="input" id="redis-create-duration" name="duration" inputmode="numeric" pattern="[0-9]+" value="60"></div><div class="field" data-redis-create-relative hidden><span class="label">Unit</span>{% include "partials/select.django" with select_name="durationUnit" select_label="Expiry unit" select_chosen="1000" select_options=ExpiryUnits select_wide=1 %}</div><div class="field" data-redis-create-absolute hidden><label class="label" for="redis-create-moment">Expire at</label><input class="input" id="redis-create-moment" name="expiresAt" type="datetime-local" max="9999-12-31T23:59"></div></div>
    <div class="alert is-bad" data-redis-create-error role="alert" hidden></div>
    <div class="actions"><button class="button is-ghost" type="button" data-reveal="redis-create">Cancel</button><button class="button" type="submit" data-redis-create-submit>Add key</button></div>
  </form>
</div>
