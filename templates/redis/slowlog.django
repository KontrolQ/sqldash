{% extends "redis/layout.django" %}
{% block rediscontent %}
  <section class="card is-panel">
    <div class="card-head"><div class="card-title">Slow log</div><div class="card-tools"><button class="button is-outline is-small" type="button" data-redis-slowlog-refresh>Refresh</button>{% if CanResetSlowLog %}<button class="button is-destructive is-small" type="button" data-redis-slowlog-reset>Reset slow log</button>{% endif %}</div></div>
    <div class="card-body">
      <div class="redis-table-wrap" data-redis-slowlog>
        <p class="field-note">Loading slow log…</p>
      </div>
      <p class="field-note">Up to 100 recent slow commands. Arguments may contain private application data. Execution time excludes client network time; truncated arguments are marked.</p>
    </div>
  </section>
{% endblock %}
