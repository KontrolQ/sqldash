{% extends "redis/layout.django" %}
{% block rediscontent %}
  <section class="card is-panel">
    <div class="card-head"><div class="card-title">Top commands</div><div class="card-tools"><span class="field-note" data-redis-measured-at></span><button class="button is-outline is-small" type="button" data-redis-commands-refresh>Refresh</button></div></div>
    <div class="card-body">
      <div class="redis-table-wrap" data-redis-commands>
        <p class="field-note">Loading command counters…</p>
      </div>
      <p class="field-note">Calls since the server counters began or were reset. CPU time is not end-to-end latency.</p>
    </div>
  </section>
{% endblock %}
