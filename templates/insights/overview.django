{% extends "layouts/base.django" %}

{% block content %}
<div class="page-head">
<div class="page-title">
<h1>{{ Heading }}</h1>
<p class="page-subtitle">Measured across {{ Scope }} over the last {{ Window }}.</p>
</div>
<div class="page-actions">
{% include "partials/period.django" with period_base=FormAction %}
<a class="button is-outline is-small" href="{{ QueriesPath }}?window={{ Window }}">Top queries</a>
</div>
</div>

{% include "partials/databasetabs.django" %}

<div class="tiles">
{% for tile in Tiles %}{% include "partials/tile.django" %}{% endfor %}
</div>

<div class="card">
<div class="card-head has-border">
<div class="card-title">Queries over time</div>
<div class="card-note">Reads and writes over the last {{ Window }}.</div>
</div>
<div class="card-body">
{% include "partials/chart.django" with chart_data=TrafficChart chart_series=TrafficSeries %}
</div>
</div>

<div class="card">
<div class="card-head has-border">
<div class="card-title">Latency over time</div>
<div class="card-note">Percentiles are read from a histogram, so they are close rather than exact.</div>
</div>
<div class="card-body">
{% include "partials/chart.django" with chart_data=LatencyChart chart_series=LatencySeries %}
</div>
</div>

<div class="card">
<div class="card-head has-border">
<div class="card-title">Latency spread</div>
<div class="card-note">Across every query in the period.</div>
</div>
<div class="card-body">
<div class="spread">
<div class="spread-part"><span class="spread-label">P50</span><span class="spread-value">{{ P50 }}</span></div>
<div class="spread-part"><span class="spread-label">P75</span><span class="spread-value">{{ P75 }}</span></div>
<div class="spread-part"><span class="spread-label">P90</span><span class="spread-value">{{ P90 }}</span></div>
<div class="spread-part"><span class="spread-label">P95</span><span class="spread-value">{{ P95 }}</span></div>
<div class="spread-part"><span class="spread-label">P99</span><span class="spread-value">{{ P99 }}</span></div>
<div class="spread-part"><span class="spread-label">Average</span><span class="spread-value">{{ Average }}</span></div>
</div>
</div>
</div>

<div class="card is-table">
<div class="card-head has-border is-padded">
<div class="card-title">Top queries</div>
<div class="card-note">The heaviest {{ Top|length }} by total time. <a class="link" href="{{ QueriesPath }}?window={{ Window }}">See them all</a>.</div>
</div>
{% if Top %}
{% include "partials/querytable.django" with query_rows=Top query_sortable=0 %}
{% else %}
<div class="card-body">
<div class="empty">
<span class="empty-title">Nothing measured yet</span>
<span>Queries appear here once clients start using a database.</span>
</div>
</div>
{% endif %}
</div>
{% endblock %}
