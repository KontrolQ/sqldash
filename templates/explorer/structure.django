{% extends "layouts/base.django" %}

{% block tight %}is-tight{% endblock %}

{% block content %}
<div class="page-head is-slim">
<div class="page-title">
<h1>{{ Database }}</h1>
<p class="page-subtitle">{{ Address }}</p>
</div>
</div>

{% include "partials/databasetabs.django" %}
{% include "partials/alert.django" %}

<div class="workspace">
{% include "partials/rail.django" with rail_base=StructurePath %}

<div class="bench">
{% if Table %}
<div class="workbar">
<div class="tabs is-compact">
<a class="tab" href="{{ BrowsePath }}?table={{ Table }}">
<svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/></svg>
Data
</a>
<a class="tab is-current" href="{{ StructurePath }}?table={{ Table }}">
<svg viewBox="0 0 24 24"><path d="M3 5h18M3 12h18M3 19h18"/></svg>
Structure
</a>
</div>
{% if IsView %}<span class="badge is-outline">view</span>{% endif %}
<div class="workbar-right">
<span class="tally">{{ Columns|length }} columns &middot; {{ Indexes|length }} indexes</span>
<button class="button is-outline is-small" type="button" data-copy="table-definition">
<svg class="button-icon" viewBox="0 0 24 24"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
Copy schema
</button>
</div>
</div>

<div class="sheet is-padded">
<div class="plan">
<div class="plan-head">
<span class="plan-kind">{% if IsView %}View{% else %}Table{% endif %}</span>
<span class="plan-name">{{ Table }}</span>
</div>

<div class="plan-group">
<div class="plan-label">Columns</div>
<div class="plan-rows">
{% for column in Columns %}
<div class="plan-row">
<span class="plan-column">{{ column.Name }}</span>
<span class="plan-type">{{ column.Kind|upper }}</span>
{% if column.PrimaryKey %}<span class="plan-flag">PRIMARY KEY</span>{% endif %}
{% if column.NotNull %}<span class="plan-flag">NOT NULL</span>{% endif %}
{% if column.Default %}<span class="plan-flag">DEFAULT {{ column.Default }}</span>{% endif %}
{% if column.References %}
<a class="chip" href="{{ StructurePath }}?table={{ column.References }}">{{ column.References }}<span class="chip-target">{{ column.OnColumn }}</span></a>
{% endif %}
</div>
{% endfor %}
</div>
</div>

{% if Indexes %}
<div class="plan-group">
<div class="plan-label">Indexes</div>
<div class="plan-rows">
{% for index in Indexes %}
<div class="plan-row">
<span class="plan-column">{{ index.Name }}</span>
<span class="plan-type">{{ index.Columns|join:", " }}</span>
{% if index.Unique %}<span class="plan-flag">UNIQUE</span>{% endif %}
<span class="plan-flag">{{ index.Origin }}</span>
</div>
{% endfor %}
</div>
</div>
{% endif %}

{% if Definition %}
<div class="plan-group">
<div class="plan-label">Definition</div>
<pre class="code is-block" id="table-definition">{{ Definition }}</pre>
</div>
{% endif %}
</div>
</div>
{% else %}
<div class="sheet-empty">
<strong>Nothing selected</strong>
<span>Choose a table on the left to see how it is built.</span>
</div>
{% endif %}
</div>
</div>
{% endblock %}
