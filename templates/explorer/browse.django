{% extends "layouts/base.django" %}
{% block tight %}
  is-tight
{% endblock %}
{% block content %}
  <div class="page-head is-slim">
    <div class="page-title">
      <h1>{{ DatabaseDisplayName|default:Database }}</h1>
      <p class="page-subtitle">{{ Address }}</p>
    </div>
  </div>
  {% include "partials/databasetabs.django" %}
  {% include "partials/alert.django" %}
  <div class="workspace explorer-data{% if Engine == "postgres" %} explorer-postgres{% endif %}">
    {% include "partials/rail.django" with rail_base=BrowsePath %}
    <div class="bench">
      {% if Table %}
        <div class="workbar">
          <button class="step" type="button" data-rail-toggle aria-label="Hide the table list" aria-expanded="true" title="Hide the table list">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/></svg>
          </button>
          <div class="tabs is-compact">
            <a class="tab is-current" href="{{ BrowsePath }}?{% if Engine == "postgres" %}{{ RelationQuery }}{% else %}table={{ Table|urlencode }}{% endif %}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/></svg>Data
            </a>
            <a class="tab" href="{{ StructurePath }}?{% if Engine == "postgres" %}{{ RelationQuery }}{% else %}table={{ Table|urlencode }}{% endif %}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18M3 12h18M3 19h18"/></svg>Structure
            </a>
          </div>
          {% if Engine == "postgres" %}<span class="badge is-outline explorer-relation-name" title="{{ Schema }}.{{ Table }}">{{ Schema }}.{{ Table }}</span>{% endif %}
          {% if ReadOnlySchema %}<span class="badge is-outline">read-only system schema</span>{% endif %}
          {% include "partials/filters.django" %}
          <div class="menu" data-menu>
            <button class="button is-outline is-small" type="button" data-menu-trigger aria-expanded="false" aria-haspopup="true">
              <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 16 4 4 4-4M7 20V4M21 8l-4-4-4 4M17 4v16"/></svg>Sort
              {% if Sort %}<span class="badge is-secondary">{{ Sort }}</span>{% endif %}
            </button>
            <div class="menu-content" data-menu-content hidden>
              <div class="menu-label">Sort by</div><div class="menu-separator"></div>
              {% for column in Columns %}
                <a class="menu-check" role="menuitemradio" aria-checked="{% if Sort == column.Name %}true{% else %}false{% endif %}" href="{{ BrowsePath }}?{{ Carry }}&sort={{ column.Name|urlencode }}&direction={% if Sort == column.Name and Direction == "asc" %}desc{% else %}asc{% endif %}">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{{ column.Name }}
                  {% if Sort == column.Name %}<span class="menu-note">{% if Direction == "asc" %}ascending{% else %}descending{% endif %}</span>{% endif %}
                </a>
              {% endfor %}
              {% if Sort %}<div class="menu-separator"></div><a class="menu-check" href="{{ BrowsePath }}?{{ Carry }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>Clear sorting</a>{% endif %}
            </div>
          </div>
          <div class="menu" data-menu data-columns="{{ Database }}.{% if Engine == "postgres" %}{{ Schema }}.{% endif %}{{ Table }}">
            <button class="button is-outline is-small" type="button" data-menu-trigger aria-expanded="false" aria-haspopup="true">
              <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18M15 3v18"/></svg>Columns
            </button>
            <div class="menu-content" data-menu-content hidden>
              <div class="menu-label">Columns shown</div><div class="menu-separator"></div>
              {% for column in Columns %}
                <button class="menu-check" type="button" role="menuitemcheckbox" aria-checked="true" data-column="{{ column.Name }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{{ column.Name }}</button>
              {% endfor %}
            </div>
          </div>
          {% if Insertable or Editable and Engine != "postgres" %}
            <button class="button is-small" type="button" data-reveal="add-row"><svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14"/></svg>Add record</button>
          {% endif %}
          <div class="workbar-right">
            <span class="timing">{{ Duration }}</span>
            <a class="step {% if Page <= 1 %}is-off{% endif %}" href="{{ BrowsePath }}?{{ Carry }}{% if Sort %}&sort={{ Sort|urlencode }}&direction={{ Direction }}{% endif %}&page={{ PreviousPage }}" aria-label="Previous page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></a>
            <span class="tally">{{ FirstRow }} &ndash; {{ LastRow }} of {{ Total }}</span>
            <a class="step {% if Page >= Pages %}is-off{% endif %}" href="{{ BrowsePath }}?{{ Carry }}{% if Sort %}&sort={{ Sort|urlencode }}&direction={{ Direction }}{% endif %}&page={{ NextPage }}" aria-label="Next page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></a>
            <a class="step" href="{{ BrowsePath }}?{{ View }}" aria-label="Reload the rows"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg></a>
            <div class="menu" data-menu>
              <button class="step" type="button" data-menu-trigger aria-expanded="false" aria-haspopup="true" aria-label="More actions"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg></button>
              <div class="menu-content" data-menu-content hidden>
                <a class="menu-plain" href="{{ StructurePath }}?{% if Engine == "postgres" %}{{ RelationQuery }}{% else %}table={{ Table|urlencode }}{% endif %}">Show structure</a>
                {% if CanRunSQL %}<a class="menu-plain" href="{% url "databases.console" name=Database %}{% if Engine == "postgres" %}?schema={{ Schema|urlencode }}{% endif %}">Open the console</a>{% endif %}
                {% if CanExportDatabases %}<div class="menu-separator"></div><a class="menu-plain" href="{% url "databases.export" name=Database %}">Download a dump</a>{% endif %}
              </div>
            </div>
          </div>
        </div>
        <div class="workbar is-second">
          <input class="input is-small is-search" form="search-form" name="search" value="{{ Search }}" placeholder="Search every column" aria-label="Search every column">
          {% if Search %}<a class="button is-ghost is-small" href="{{ BrowsePath }}?{{ CarryNoSearch }}{% if Sort %}&sort={{ Sort|urlencode }}&direction={{ Direction }}{% endif %}">Clear</a>{% endif %}
          <div class="workbar-right">
            {% if Editable %}
              <div class="workbar-group" data-selection-bar hidden><span class="selection-count" data-selection-count></span><button class="button is-ghost is-small" type="button" data-selection-clear>Clear</button><button class="button is-destructive is-small" type="submit" form="row-form">Delete rows</button></div>
              {% if Engine != "postgres" or GridEditor == "postgres" %}
                <div class="workbar-group">
                  <button class="button is-ghost is-small" type="button" data-grid-discard disabled>Discard</button>
                  <button class="button is-small" type="submit" form="grid-form" data-grid-save disabled>Save changes <span class="badge is-secondary" data-grid-count>0</span></button>
                </div>
              {% endif %}
            {% endif %}
          </div>
        </div>
        {% if Engine == "postgres" and not Editable and Insertable %}
          <div class="explorer-key-note field-note">This table has no primary key. Records can be added, but existing rows cannot be edited or deleted.</div>
        {% endif %}
        {% if Unavailable %}
          <div class="sheet-empty" role="status"><strong>Data unavailable</strong><span>{{ Unavailable }}</span></div>
        {% else %}
          <div class="sheet">
            <table class="table is-grid">
              <thead>
                <tr>
                  {% if Editable %}
                    <th scope="col" class="table-pick">{% include "partials/checkbox.django" with checkbox_label="Pick every row on this page" checkbox_hook="selection-all" %}</th>
                  {% endif %}
                  {% for column in Columns %}
                    <th scope="col" data-cell="{{ column.Name }}">
                    <a class="column-sort" href="{{ BrowsePath }}?{{ Carry }}&sort={{ column.Name|urlencode }}&direction={% if Sort == column.Name and Direction == "asc" %}desc{% else %}asc{% endif %}">
                      <span class="column-name">{{ column.Name }}</span><span class="column-kind">{{ column.Kind|lower }}</span>
                      {% if column.ReadOnly %}<span class="badge is-outline">read-only</span>{% endif %}
                      {% if Sort == column.Name %}<span class="sort-mark">{% if Direction == "asc" %}&uarr;{% else %}&darr;{% endif %}</span>{% endif %}
                    </a>
                  </th>
                  {% endfor %}
                  {% if Editable %}
                    <th scope="col" class="table-pick"></th>
                  {% endif %}
                </tr>
              </thead>
              <tbody>
                {% for row in Rows %}
                  <tr data-key="{{ row.Key }}">
                    {% if Editable %}
                      <td class="table-pick">{% include "partials/checkbox.django" with checkbox_name="key" checkbox_value=row.Key checkbox_label="Pick this row" checkbox_hook="selection-one" checkbox_form="row-form" %}</td>
                    {% endif %}
                    {% for cell in row.Cells %}
                      <td class="cell" data-cell="{{ cell.Column }}"{% if Editable and not cell.ReadOnly %}{% if Engine != "postgres" or GridEditor == "postgres" %} data-edit tabindex="-1"{% endif %}{% endif %}>
                      <span class="cell-body">
                        <span class="cell-text{% if cell.IsNull %} null{% endif %}"{% if Engine == "postgres" %} title="{{ cell.Value }}"{% endif %}>{% if cell.IsNull %}NULL{% else %}{{ cell.Text }}{% endif %}</span>
                        {% if cell.LinkTo %}
                          {% if cell.Peek %}<button class="chip" type="button" data-peek="peek-{{ forloop.Parentloop.Counter }}-{{ forloop.Counter }}" aria-expanded="false" title="Show the matching row in {{ cell.LinkTo }}">{{ cell.LinkTo }}</button>{% else %}<span class="chip is-missing" title="{% if Engine == "postgres" %}Preview unavailable for {{ cell.LinkTo }}{% else %}Nothing in {{ cell.LinkTo }} matches{% endif %}">{{ cell.LinkTo }}</span>{% endif %}
                          <a class="cell-jump" href="{{ BrowsePath }}?{% if cell.LinkQuery %}{{ cell.LinkQuery }}{% else %}table={{ cell.LinkTo|urlencode }}{% if cell.LinkColumn %}&column={{ cell.LinkColumn|urlencode }}&operator=is&value={{ cell.Text|urlencode }}{% else %}&search={{ cell.Text|urlencode }}{% endif %}{% endif %}" aria-label="Open {{ cell.LinkTo }} filtered to this row" title="Open in {{ cell.LinkTo }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></a>
                        {% endif %}
                      </span>
                    </td>
                    {% endfor %}
                    {% if Editable %}
                      <td class="table-pick">
                      {% if Engine == "postgres" and GridEditor != "postgres" %}<button class="button is-ghost is-small" type="button" data-reveal="edit-row-{{ forloop.Counter }}">Edit</button>{% endif %}
                      <button class="step is-bare" type="submit" form="row-form" name="key" value="{{ row.Key }}" data-row-delete aria-label="Delete this row" data-confirm="This row is removed from {{ Table }}. This cannot be undone." data-confirm-title="Delete this row?" data-confirm-action="Delete row"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg></button>
                    </td>
                    {% endif %}
                  </tr>
                  {% for cell in row.Cells %}
                    {% if cell.Peek %}
                      <tr class="peek-row" id="peek-{{ forloop.Parentloop.Counter }}-{{ forloop.Counter }}" hidden>
                        <td colspan="{% if Editable %}{{ Columns|length|add:2 }}{% else %}{{ Columns|length }}{% endif %}">
                          <div class="peek">
                            <div class="peek-head"><span class="chip">{{ cell.Peek.Table }}</span><a class="button is-outline is-small" href="{{ BrowsePath }}?{% if cell.LinkQuery %}{{ cell.LinkQuery }}{% else %}table={{ cell.LinkTo|urlencode }}{% if cell.LinkColumn %}&column={{ cell.LinkColumn|urlencode }}&operator=is&value={{ cell.Text|urlencode }}{% else %}&search={{ cell.Text|urlencode }}{% endif %}{% endif %}">Open in sub view</a></div>
                            <div class="table-wrap">
                              <table class="table is-grid is-peek">
                                <thead>
                                  <tr>
                                    {% for name in cell.Peek.Columns %}
                                      <th scope="col">{{ name }}</th>
                                    {% endfor %}
                                  </tr>
                                </thead>
                                <tbody>
                                  <tr>
                                    {% for one in cell.Peek.Cells %}
                                      <td class="cell"><span class="cell-text{% if one.IsNull %} null{% endif %}">{% if one.IsNull %}NULL{% else %}{{ one.Text }}{% endif %}</span></td>
                                    {% endfor %}
                                  </tr>
                                </tbody>
                              </table>
                            </div>
                          </div>
                        </td>
                      </tr>
                    {% endif %}
                  {% endfor %}
                {% empty %}
                  <tr>
                    <td colspan="{% if Editable %}{{ Columns|length|add:2 }}{% else %}{{ Columns|length }}{% endif %}" class="cell-empty">No rows match.</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}
        <form id="search-form" method="get" action="{{ BrowsePath }}" hidden>
          {% if Engine == "postgres" %}<input type="hidden" name="schema" value="{{ Schema }}">{% endif %}
          <input type="hidden" name="table" value="{{ Table }}">
          {% if Sort %}<input type="hidden" name="sort" value="{{ Sort }}"><input type="hidden" name="direction" value="{{ Direction }}">{% endif %}
          {% for filter in Filters %}<input type="hidden" name="column" value="{{ filter.Column }}"><input type="hidden" name="operator" value="{{ filter.Operator }}"><input type="hidden" name="value" value="{{ filter.Value }}">{% endfor %}
        </form>
        <form id="filter-form" method="get" action="{{ BrowsePath }}" hidden>
          {% if Engine == "postgres" %}<input type="hidden" name="schema" value="{{ Schema }}">{% endif %}
          <input type="hidden" name="table" value="{{ Table }}">
          {% if Search %}<input type="hidden" name="search" value="{{ Search }}">{% endif %}
          {% if Sort %}<input type="hidden" name="sort" value="{{ Sort }}"><input type="hidden" name="direction" value="{{ Direction }}">{% endif %}
        </form>
        {% if Editable %}
          <form id="row-form" class="selection" method="post" action="{% url "databases.explore.row" name=Database %}" data-selection data-confirm="The rows you picked are removed from {{ Table }}. This cannot be undone." data-confirm-title="Delete the rows you picked?" data-confirm-action="Delete rows" hidden>
            {% if Engine == "postgres" %}<input type="hidden" name="schema" value="{{ Schema }}">{% endif %}<input type="hidden" name="table" value="{{ Table }}"><input type="hidden" name="back" value="{{ View }}">
          </form>
          {% if Engine != "postgres" or GridEditor == "postgres" %}
            <form id="grid-form" method="post" action="{% url "databases.explore.cell" name=Database %}" data-grid-engine="{% if Engine == "postgres" %}postgres{% else %}libsql{% endif %}" hidden>
              {% if Engine == "postgres" %}<input type="hidden" name="schema" value="{{ Schema }}"><input type="hidden" name="value_encoding" value="json">{% endif %}<input type="hidden" name="table" value="{{ Table }}"><input type="hidden" name="back" value="{{ View }}">
            </form>
            {% if GridData %}
              <script type="application/json" data-grid-values>{{ GridData|safe }}</script>
            {% endif %}
          {% endif %}
        {% endif %}
        {% if Engine == "postgres" %}
          {% include "explorer/postgresbrowse.django" %}
        {% elif Editable %}
          <div class="drawer" id="add-row" hidden>
            <div class="drawer-head"><span class="card-title">Add a record to {{ Table }}</span><button class="step" type="button" data-reveal="add-row" aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button></div>
            <form class="drawer-body" method="post" action="{% url "databases.explore.insert" name=Database %}">
              <input type="hidden" name="table" value="{{ Table }}">
              <input type="hidden" name="columns" value="{{ ColumnNames }}">
              <input type="hidden" name="back" value="{{ View }}">
              <div class="row">
                {% for column in Columns %}<div class="field"><label class="label" for="new-{{ column.Name }}">{{ column.Name }}</label><input class="input" id="new-{{ column.Name }}" name="column.{{ column.Name }}"><span class="field-note">{{ column.Kind }}{% if column.PrimaryKey %} &middot; primary key{% endif %}{% if column.NotNull %} &middot; required{% endif %}</span></div>{% endfor %}
              </div>
              <div class="actions"><button class="button is-ghost" type="button" data-reveal="add-row">Cancel</button><button class="button" type="submit">Add record</button></div>
            </form>
          </div>
        {% endif %}
      {% else %}
        <div class="sheet-empty"><strong>Nothing selected</strong><span>Choose a table on the left to see its rows.</span></div>
      {% endif %}
    </div>
  </div>
{% endblock %}
{% block styles %}
  <link rel="stylesheet" href="{% static "css/postgres-explorer.css" %}">
{% endblock %}
