<div class="drawer explorer-object-manager" id="object-manager" hidden>
  <div class="drawer-head"><span class="card-title">Manage database objects</span><button class="button is-ghost is-small" type="button" data-reveal="object-manager">Close</button></div>
  <div class="drawer-body stack">
    <details>
      <summary class="label">Schemas</summary>
      <form class="stack" method="post" action="{{ ObjectPath }}">
        <input type="hidden" name="kind" value="schema">
        <div class="field"><label class="label" for="schema-action">Operation</label><div class="select is-wide" data-select><select name="action" id="schema-action"><option value="create">Create schema</option><option value="rename">Rename schema</option><option value="drop">Drop schema</option></select><button class="select-trigger is-wide" type="button" data-select-trigger aria-haspopup="listbox" aria-expanded="false"><span data-select-label></span></button><div class="select-content" role="listbox" data-select-content hidden></div></div></div>
        <div class="field"><label class="label" for="schema-name">Schema name</label><input class="input" id="schema-name" name="schema" value="{{ Schema }}" required></div>
        <div class="field"><label class="label" for="schema-new-name">New name (rename only)</label><input class="input" id="schema-new-name" name="new_name"></div>
        <label class="explorer-check"><input type="checkbox" name="confirmed" value="true">Confirm destructive changes</label>
        <label class="explorer-check"><input type="checkbox" name="cascade" value="true">Also remove dependent objects (CASCADE)</label>
        <div class="actions"><button class="button is-outline" type="submit">Apply schema operation</button></div>
      </form>
    </details>
    <form class="stack" method="post" action="{{ ObjectPath }}" data-object-form>
      <input type="hidden" name="schema" value="{{ Schema }}">
      <div class="explorer-fields">
        <div class="field"><label class="label" for="object-kind">Object</label><div class="select is-wide" data-select><select name="kind" id="object-kind"><option value="table">Table</option><option value="view">View</option><option value="materialized view">Materialized view</option><option value="column">Column</option><option value="constraint">Constraint</option><option value="index">Index</option><option value="function">Function</option><option value="sequence">Sequence</option></select><button class="select-trigger is-wide" type="button" data-select-trigger aria-haspopup="listbox" aria-expanded="false"><span data-select-label></span></button><div class="select-content" role="listbox" data-select-content hidden></div></div></div>
        <div class="field"><label class="label" for="object-action">Operation</label><div class="select is-wide" data-select><select name="action" id="object-action"><option value="create">Create</option><option value="rename">Rename</option><option value="drop">Drop</option><option value="refresh">Refresh</option><option value="replace">Replace definition</option><option value="add">Add</option><option value="type">Change type</option><option value="default">Set default value</option><option value="drop_default">Remove default</option><option value="not_null">Require a value</option><option value="nullable">Allow NULL</option><option value="alter">Change options</option></select><button class="select-trigger is-wide" type="button" data-select-trigger aria-haspopup="listbox" aria-expanded="false"><span data-select-label></span></button><div class="select-content" role="listbox" data-select-content hidden></div></div></div>
        <div class="field" data-object-field="target_schema"><span class="label">Target schema</span>{% include "partials/select.django" with select_name="target_schema" select_label="Target schema" select_options=MutableSchemas select_chosen=Schema select_wide=true %}<span class="field-note">The new table is created in this schema. Existing relation operations stay in {{ Schema }}.</span></div>
        <div class="field" data-object-field="name"><label class="label" for="object-name">Object name</label><input class="input" id="object-name" name="name"></div>
        <div class="field" data-object-field="table"><label class="label" for="object-table">Relation in {{ Schema }}</label><div class="select is-wide" data-select><select name="table" id="object-table">{% for one in Tables %}<option value="{{ one.Name }}" {% if one.Name == Table %}selected{% endif %}>{{ one.Name }} ({{ one.Kind }})</option>{% endfor %}</select><button class="select-trigger is-wide" type="button" data-select-trigger aria-haspopup="listbox" aria-expanded="false"><span data-select-label></span></button><div class="select-content" role="listbox" data-select-content hidden></div></div><span class="field-note">Column, constraint and index choices use the currently selected relation.</span></div>
        <div class="field" data-object-field="new_name"><label class="label" for="object-new-name">New name</label><input class="input" id="object-new-name" name="new_name"></div>
        <div class="field" data-object-field="column"><label class="label" for="object-column">Column name</label><input class="input" id="object-column" name="column" list="object-columns"><datalist id="object-columns">{% for column in Columns %}<option value="{{ column.Name }}">{% endfor %}</datalist></div>
        <div class="field" data-object-field="type"><span class="label">Column type</span>{% include "partials/select.django" with select_name="type" select_label="Column type" select_options=Kinds select_chosen="text" select_wide=true %}</div>
      </div>
      <div data-object-field="column_definitions" class="stack">
        <span class="label">Table columns</span><div data-object-column-rows class="stack"><div class="explorer-column-definition"><input class="input" name="column_name" aria-label="Column name" placeholder="Column name" required>{% include "partials/select.django" with select_name="column_type" select_label="Column type" select_options=Kinds select_chosen="text" select_wide=true %}<button class="button is-ghost is-small" type="button" data-object-column-remove>Remove</button>{% include "explorer/columndefaults.django" %}</div></div>
        <button class="button is-outline is-small" type="button" data-object-column-add>Add column</button>
      </div>
      <div data-object-field="columns" class="field"><span class="label">Columns in key order</span><input class="input" name="columns_text" data-object-column-list placeholder="id, region" aria-label="Columns in key order"><span class="field-note">Comma-separated existing column names. Double-quote names containing commas.</span></div>
      <div data-object-field="constraint_kind" class="field"><label class="label" for="object-constraint-kind">Constraint kind</label><div class="select is-wide" data-select><select name="constraint_kind" id="object-constraint-kind"><option value="primary">Primary key</option><option value="foreign">Foreign key</option><option value="unique">Unique</option><option value="check">Check</option></select><button class="select-trigger is-wide" type="button" data-select-trigger aria-haspopup="listbox" aria-expanded="false"><span data-select-label></span></button><div class="select-content" role="listbox" data-select-content hidden></div></div></div>
      <div data-object-field="references" class="explorer-fields"><div class="field"><label class="label" for="object-reference-schema">Referenced schema</label><input class="input" name="reference_schema" id="object-reference-schema" value="{{ Schema }}"></div><div class="field"><label class="label" for="object-reference-table">Referenced table</label><input class="input" name="reference_table" id="object-reference-table"></div><div class="field"><label class="label" for="object-reference-columns">Referenced columns in key order</label><input class="input" name="reference_columns_text" data-object-reference-list id="object-reference-columns"></div></div>
      <div data-object-field="expression" class="field">
        <label class="label" for="object-expression">Definition</label>
        <textarea class="input explorer-definition" name="expression" id="object-expression" rows="7"></textarea>
        <span class="field-note">Views: one SELECT or WITH query. Checks: one expression. Functions: a SQL or PL/pgSQL body; runs as the caller, with argument1, argument2, &hellip; available.</span>
      </div>
      <div data-object-field="value" class="field"><label class="label" for="object-value">Default value</label><input class="input" name="value" id="object-value"><span class="field-note">A typed literal value, not a SQL expression.</span></div>
      <div data-object-field="function" class="explorer-fields">
        <div class="field"><label class="label" for="object-function-language">Language</label><div class="select is-wide" data-select><select name="language" id="object-function-language"><option value="sql">SQL</option><option value="plpgsql">PL/pgSQL</option></select><button class="select-trigger is-wide" type="button" data-select-trigger aria-haspopup="listbox" aria-expanded="false"><span data-select-label></span></button><div class="select-content" role="listbox" data-select-content hidden></div></div></div>
        <div class="field"><label class="label" for="object-return-type">Return type</label><div class="select is-wide" data-select><select name="returns" id="object-return-type"><option value="void">void</option>{% for choice in Kinds %}<option value="{{ choice.Value }}">{{ choice.Label }}</option>{% endfor %}</select><button class="select-trigger is-wide" type="button" data-select-trigger aria-haspopup="listbox" aria-expanded="false"><span data-select-label></span></button><div class="select-content" role="listbox" data-select-content hidden></div></div></div>
        <div class="field"><label class="label" for="object-arguments">Argument types</label><input class="input" name="argument_types_text" data-object-argument-list id="object-arguments" placeholder="integer, text"><span class="field-note">Comma-separated types; leave empty for no arguments.</span></div>
      </div>
      <div data-object-field="signature" class="field"><label class="label" for="object-signature">Function signature</label><div class="select is-wide" data-select><select name="signature" id="object-signature">{% for function in Functions %}<option value="{{ function.Name }}">{{ function.Name }}</option>{% endfor %}</select><button class="select-trigger is-wide" type="button" data-select-trigger aria-haspopup="listbox" aria-expanded="false"><span data-select-label></span></button><div class="select-content" role="listbox" data-select-content hidden></div></div></div>
      <div data-object-field="sequence" class="explorer-fields"><div class="field"><label class="label" for="sequence-start">Start</label><input class="input" name="start" id="sequence-start" inputmode="numeric"></div><div class="field"><label class="label" for="sequence-increment">Increment</label><input class="input" name="increment" id="sequence-increment" inputmode="numeric"></div><div class="field"><label class="label" for="sequence-minimum">Minimum</label><input class="input" name="minimum" id="sequence-minimum" inputmode="numeric"></div><div class="field"><label class="label" for="sequence-maximum">Maximum</label><input class="input" name="maximum" id="sequence-maximum" inputmode="numeric"></div></div>
      <label data-object-field="unique" class="explorer-check"><input type="checkbox" name="unique" value="true">Unique index</label>
      <div data-object-field="column_options" class="explorer-fields"><div class="field"><span class="label">Generation</span><div class="select is-wide" data-select><select name="mode" aria-label="Column generation"><option value="plain">Ordinary column</option><option value="identity">Identity (integer types)</option><option value="generated">Generated (stored)</option></select><button class="select-trigger is-wide" type="button" data-select-trigger aria-haspopup="listbox" aria-expanded="false"><span data-select-label></span></button><div class="select-content" role="listbox" data-select-content hidden></div></div></div><div class="field"><span class="label">Default</span><div class="select is-wide" data-select><select name="default_state" aria-label="Column default state"><option value="unset">No default</option><option value="value">Typed literal value</option><option value="null">NULL</option></select><button class="select-trigger is-wide" type="button" data-select-trigger aria-haspopup="listbox" aria-expanded="false"><span data-select-label></span></button><div class="select-content" role="listbox" data-select-content hidden></div></div></div></div>
      <label data-object-field="not_null" class="explorer-check"><input type="checkbox" name="not_null" value="true">Require a value</label>
      <div data-object-field="destructive" class="stack"><span class="field-note">Dependent objects prevent the change unless CASCADE is explicitly selected.</span><label class="explorer-check"><input type="checkbox" name="confirmed" value="true">Confirm destructive change</label><label class="explorer-check"><input type="checkbox" name="cascade" value="true">Also remove dependent objects (CASCADE)</label></div>
      <div class="actions"><button class="button" type="submit">Apply change</button></div>
    </form>
  </div>
</div>
