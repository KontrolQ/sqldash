<div class="explorer-column-properties">
  <div class="field"><span class="label">Generation</span><div class="select is-wide" data-select><select name="column_mode" aria-label="Column generation"><option value="plain">Ordinary column</option><option value="identity">Identity (integer types)</option><option value="generated">Generated (stored)</option></select><button class="select-trigger is-wide" type="button" data-select-trigger aria-haspopup="listbox" aria-expanded="false"><span data-select-label></span></button><div class="select-content" role="listbox" data-select-content hidden></div></div></div>
  <div class="field"><span class="label">Nullability</span><div class="select is-wide" data-select><select name="column_required" aria-label="Column nullability"><option value="nullable">Allow NULL</option><option value="required">Require a value</option></select><button class="select-trigger is-wide" type="button" data-select-trigger aria-haspopup="listbox" aria-expanded="false"><span data-select-label></span></button><div class="select-content" role="listbox" data-select-content hidden></div></div></div>
  <div class="field"><span class="label">Default</span><div class="select is-wide" data-select><select name="column_default_state" aria-label="Column default state"><option value="unset">No default</option><option value="value">Typed literal value</option><option value="null">NULL</option></select><button class="select-trigger is-wide" type="button" data-select-trigger aria-haspopup="listbox" aria-expanded="false"><span data-select-label></span></button><div class="select-content" role="listbox" data-select-content hidden></div></div></div>
  <div class="field"><label class="label">Default literal<input class="input" name="column_default_value" aria-label="Column default literal"></label></div>
  <div class="field"><label class="label">Generated expression<input class="input" name="column_expression" aria-label="Generated column expression" placeholder="price * quantity"></label><span class="field-note">Only for a generated column.</span></div>
</div>
