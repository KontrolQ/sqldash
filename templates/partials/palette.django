<button class="palette-open" type="button" data-palette-open>
<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
<span class="palette-open-text">Search</span>
<kbd class="kbd">Ctrl K</kbd>
</button>

<div class="palette" hidden>
<div class="dialog-veil" data-palette-close></div>
<div class="command" role="dialog" aria-modal="true" aria-label="Command palette">
<div class="command-search">
<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
<input class="command-input" type="text" autocomplete="off" spellcheck="false" placeholder="Type to search" aria-label="Type to search" aria-controls="command-list">
</div>
<div class="command-list" id="command-list" role="listbox">
{% for group in Palette %}
<div class="command-group" data-group>
<div class="command-group-label">{{ group.Label }}</div>
{% for item in group.Items %}
<a class="command-item" role="option" href="{{ item.URL }}" data-item>
<span class="command-item-label">{{ item.Label }}</span>
{% if item.Note %}<span class="command-shortcut">{{ item.Note }}</span>{% endif %}
</a>
{% endfor %}
</div>
{% endfor %}
<div class="command-empty" hidden>Nothing found.</div>
</div>
</div>
</div>
