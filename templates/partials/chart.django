<div class="chart" data-chart>
{% if chart_data %}
<div class="chart-key">
{% for name in chart_series %}<span><span class="chart-swatch is-{{ forloop.Counter0 }}"></span>{{ name }}</span>{% endfor %}
</div>
<div data-chart-canvas></div>
<div class="chart-tip" data-chart-tip hidden></div>
<script type="application/json">{{ chart_data|safe }}</script>
{% else %}
<div class="chart-empty">Nothing measured yet.</div>
{% endif %}
</div>
