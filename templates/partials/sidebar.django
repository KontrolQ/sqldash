<aside class="sidebar">
<a class="sidebar-brand brand" href="{% url "databases" %}">
<img class="brand-mark" src="{% static "logo.svg" %}" alt="" width="26" height="26">
<span class="brand-name">sqldash</span>
</a>

<nav class="sidebar-nav">
<span class="sidebar-label">Platform</span>

<a class="sidebar-link {% if "databases"|active:Request.Path %}is-active{% endif %}" href="{% url "databases" %}">
<svg class="sidebar-icon" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>
<span>Databases</span>
</a>

<a class="sidebar-link {% if "insights"|active:Request.Path %}is-active{% endif %}" href="{% url "insights" %}">
<svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
<span>Insights</span>
</a>

<a class="sidebar-link {% if "settings.index"|active:Request.Path %}is-active{% endif %}" href="{% url "settings.index" %}">
<svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"/><circle cx="12" cy="12" r="3"/></svg>
<span>Settings</span>
</a>
</nav>

<div class="sidebar-foot">
<a class="sidebar-account" href="{% url "settings.index" %}">
<span class="sidebar-avatar">{{ Account.Initial }}</span>
<span class="sidebar-account-text">
<span class="sidebar-account-name">{{ Account.Username }}</span>
<span class="sidebar-account-note">{{ Account.Email }}</span>
</span>
</a>
</div>
</aside>
