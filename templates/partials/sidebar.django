<aside class="sidebar">
  <a class="sidebar-brand brand" href="{% url "databases" %}">
<img class="brand-mark" src="{% static "logo.svg" %}" alt="" width="26" height="26">
<span class="brand-name">sqldash</span>
</a>
  <nav class="sidebar-nav">
    <span class="sidebar-label">Platform</span>
    {% if CanViewDatabases %}
      <a class="sidebar-link {% if "databases"|active:Request.Path %}is-active{% endif %}" href="{% url "databases" %}">
<svg class="sidebar-icon" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>
<span>Databases</span>
</a>
    {% endif %}
    {% if CanViewInsights %}
      <a class="sidebar-link {% if "insights"|active:Request.Path %}is-active{% endif %}" href="{% url "insights" %}">
<svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
<span>Insights</span>
</a>
    {% endif %}
    {% if CanViewAudit %}
      <a class="sidebar-link {% if "audit"|active:Request.Path %}is-active{% endif %}" href="{% url "audit" %}">
<svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 13h6M9 17h4"/></svg>
<span>Audit log</span>
</a>
    {% endif %}
    <a class="sidebar-link {% if "settings.index"|active:Request.Path %}is-active{% endif %}" href="{% url "settings.index" %}">
<svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"/><circle cx="12" cy="12" r="3"/></svg>
<span>Settings</span>
</a>
    {% if CanManageUsers or CanManageRoles or CanManageSMTP %}
      <span class="sidebar-label">Administration</span>
    {% endif %}
    {% if CanManageUsers %}
      <a class="sidebar-link {% if "users.index"|active:Request.Path %}is-active{% endif %}" href="{% url "users.index" %}"><svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg><span>Users</span></a>
    {% endif %}
    {% if CanManageRoles %}
      <a class="sidebar-link {% if "admin.roles"|active:Request.Path %}is-active{% endif %}" href="{% url "admin.roles" %}"><svg class="sidebar-icon" viewBox="0 0 24 24"><path d="m12 3 8 4v5c0 5-8 9-8 9s-8-4-8-9V7l8-4Z"/><path d="m8 12 3 3 5-6"/></svg><span>Roles & Permissions</span></a>
    {% endif %}
    {% if CanManageSMTP %}
      <a class="sidebar-link {% if "admin.smtp"|active:Request.Path %}is-active{% endif %}" href="{% url "admin.smtp" %}"><svg class="sidebar-icon" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg><span>SMTP settings</span></a>
    {% endif %}
  </nav>
  <div class="sidebar-foot">
    <div class="menu sidebar-profile" data-menu>
      <button class="sidebar-account" type="button" data-menu-trigger aria-expanded="false" aria-controls="sidebar-profile-menu">
<span class="sidebar-avatar">
      {% if Account.ProfilePicture %}
        <img class="account-picture" src="{{ Account.ProfilePicture }}" alt="">
      {% else %}
        {{ Account.Initial }}
      {% endif %}
      </span>
<span class="sidebar-account-text">
<span class="sidebar-account-name">{{ Account.DisplayName }}</span>
<span class="sidebar-account-note">{{ Account.Email }}</span>
</span>
<svg class="sidebar-icon sidebar-account-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 15 6-6 6 6"/></svg>
</button>
      <div class="menu-content sidebar-profile-menu" id="sidebar-profile-menu" data-menu-content hidden>
        <a class="menu-check" href="{% url "settings.index" %}">
<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"/><circle cx="12" cy="12" r="3"/></svg>
<span>Settings</span>
</a>
        <form method="post" action="{% url "auth.logout" %}" hx-boost="false">
          <button class="menu-check" type="submit">
<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5M21 12H9"/></svg>
<span>Log out</span>
</button>
        </form>
      </div>
    </div>
  </div>
</aside>
