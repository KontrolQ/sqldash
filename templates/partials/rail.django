<aside class="rail">
  {% if Engine == "postgres" %}
    <form class="rail-head explorer-schema" method="get" action="{{ rail_base }}">
      <div class="field"><span class="label">Schema</span>{% include "partials/select.django" with select_name="schema" select_label="Schema" select_options=Schemas select_chosen=Schema select_wide=true select_submits=true %}</div>
    </form>
  {% endif %}
  <div class="rail-head">
    <input class="input" type="search" placeholder="Search tables" aria-label="Search the table list" data-rail-search>
<a class="step" href="{{ rail_base }}?{% if Engine == "postgres" %}schema={{ Schema|urlencode }}&{% endif %}table={{ Table|urlencode }}" title="Reload the list" aria-label="Reload the list">
<svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
</a>
  </div>
  <div class="rail-list">
    {% for one in Tables %}
      {% if not one.IsView %}
        <a class="rail-item {% if one.Name == Table %}is-current{% endif %}" href="{{ rail_base }}?{% if Engine == "postgres" %}{{ one.Query }}{% else %}table={{ one.Name|urlencode }}{% endif %}" data-rail-row="{{ one.Name }}">
<svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/></svg>
<span class="rail-name">{{ one.Name }}</span>{% if Engine == "postgres" %}<span class="badge is-outline">{{ one.Kind }}</span>{% endif %}
</a>
      {% endif %}
    {% endfor %}
    {% for one in Tables %}
      {% if one.IsView %}
        {% if forloop.First %}
          <div class="rail-group">Views</div>
        {% endif %}
        <a class="rail-item {% if one.Name == Table %}is-current{% endif %}" href="{{ rail_base }}?{% if Engine == "postgres" %}{{ one.Query }}{% else %}table={{ one.Name|urlencode }}{% endif %}" data-rail-row="{{ one.Name }}">
<svg viewBox="0 0 24 24"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7"/><circle cx="12" cy="12" r="3"/></svg>
<span class="rail-name">{{ one.Name }}</span>{% if Engine == "postgres" %}<span class="badge is-outline">{{ one.Kind }}</span>{% endif %}
</a>
      {% endif %}
    {% endfor %}
    {% if not Tables %}
      <div class="rail-empty">No tables yet.</div>
    {% endif %}
  </div>
</aside>
