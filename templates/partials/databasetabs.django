{% if Database %}
<div class="tab-bar">
<div class="tabs">
<a class="tab {% if Section == "overview" %}is-current{% endif %}" href="{% url "databases.show" name=Database %}">
<svg viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>
Overview
</a>
<a class="tab {% if Section == "data" %}is-current{% endif %}" href="{% url "databases.explore" name=Database %}">
<svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M3 15h18M12 3v18"/></svg>
Data
</a>
<a class="tab {% if Section == "console" %}is-current{% endif %}" href="{% url "databases.console" name=Database %}">
<svg viewBox="0 0 24 24"><path d="m7 8 3 4-3 4M13 16h4"/><rect width="20" height="16" x="2" y="4" rx="2"/></svg>
Console
</a>
<a class="tab {% if Section == "insights" %}is-current{% endif %}" href="{% url "databases.insights" name=Database %}">
<svg viewBox="0 0 24 24"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M18 17V9M13 17V5M8 17v-3"/></svg>
Insights
</a>
<a class="tab {% if Section == "queries" %}is-current{% endif %}" href="{% url "databases.queries" name=Database %}">
<svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h10M4 18h6"/><circle cx="18" cy="16" r="3"/><path d="m21 19-1.5-1.5"/></svg>
Top queries
</a>
</div>
</div>
{% endif %}
