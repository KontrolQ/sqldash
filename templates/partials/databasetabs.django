{% if Database %}
  <div class="tab-bar">
    <div class="tabs">
      {% if CanViewDatabases %}
        <a class="tab {% if Section == "overview" %}is-current{% endif %}" href="{% url "databases.show" name=Database %}">Overview</a>
      {% endif %}
      {% if CanReadData %}
        <a class="tab {% if Section == "data" %}is-current{% endif %}" href="{% url "databases.explore" name=Database %}">Data</a>
      {% endif %}
      {% if CanRunSQL %}
        <a class="tab {% if Section == "console" %}is-current{% endif %}" href="{% url "databases.console" name=Database %}">Console</a>
      {% endif %}
      {% if CanViewInsights %}
        <a class="tab {% if Section == "insights" %}is-current{% endif %}" href="{% url "databases.insights" name=Database %}">Insights</a>
    <a class="tab {% if Section == "queries" %}is-current{% endif %}" href="{% url "databases.queries" name=Database %}">{% if IsRedis or Engine == "redis" %}Top commands{% else %}Top queries{% endif %}</a>
      {% endif %}
      {% if IsRedis or Engine == "redis" %}
        {% if CanViewSlowLog %}<a class="tab {% if Section == "slowlog" %}is-current{% endif %}" href="{% url "databases.redis.slowlog" name=Database %}">Slow log</a>{% endif %}
        {% if CanMonitorRedis %}<a class="tab {% if Section == "monitor" %}is-current{% endif %}" href="{% url "databases.redis.monitor" name=Database %}">Monitor</a>{% endif %}
        {% if CanSubscribeRedis or CanPublishRedis %}<a class="tab {% if Section == "pubsub" %}is-current{% endif %}" href="{% url "databases.redis.pubsub" name=Database %}">Pub/Sub</a>{% endif %}
        {% if CanManageConnections or CanViewActivity %}<a class="tab {% if Section == "connections" %}is-current{% endif %}" href="{% url "databases.connections" name=Database %}">Connections</a>{% endif %}
      {% endif %}
      {% if IsPostgres and CanViewActivity %}
        <a class="tab {% if Section == "connections" or Section == "activity" %}is-current{% endif %}" href="{% url "databases.connections" name=Database %}">Connections</a>
      {% endif %}
      {% if IsPostgres and CanManageExtensions %}
        <a class="tab {% if Section == "extensions" %}is-current{% endif %}" href="{% url "databases.extensions" name=Database %}">Extensions</a>
      {% endif %}
      {% if CanShareDatabase %}
        <a class="tab {% if Section == "sharing" %}is-current{% endif %}" href="{% url "databases.sharing" name=Database %}">Sharing</a>
      {% endif %}
    </div>
  </div>
{% endif %}
