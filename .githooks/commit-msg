#!/usr/bin/env bash
set -euo pipefail

message="$1"

if grep -Eiq '^[[:space:]]*(Co-Authored-By|Claude-Session)[[:space:]]*:' "$message"; then
  printf '%s\n' 'Commit rejected: attribution trailers are not allowed in this project.' >&2
  exit 1
fi

subject=''
while IFS= read -r line || [[ -n "$line" ]]; do
  line="${line%$'\r'}"
  if [[ "$line" =~ ^[[:space:]]*# || "$line" =~ ^[[:space:]]*$ ]]; then
    continue
  fi
  if [[ -n "$subject" ]]; then
    printf '%s\n' 'Commit rejected: use a single-line commit message without a body or trailers.' >&2
    exit 1
  fi
  subject="$line"
done < "$message"

if [[ ! "$subject" =~ ^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^\)]+\))?(!)?:[[:space:]]+[^[:space:]] ]]; then
  printf '%s\n' 'Commit rejected: use a semantic subject such as "feat: add profile pictures".' >&2
  exit 1
fi
